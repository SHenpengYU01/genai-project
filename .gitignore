# 本地环境变量（API key 等，不入库；模板 .env.example 入库）
.env
.env.*
!.env.example

# 本地环境说明（不入库）
*.txt

# 日志
*.log

# Python
__pycache__/
*.pyc

# CODESYS 生成物（模板工程 template.project 单独保留入库）
*.opt
*.precompilecache
*.simulation.*

# 编译服务临时目录（生成的工程副本、请求/响应文件）
tool/work/
tester/work/

# 实验运行日志（结果按需单独保存/汇总进报告）
experiments/runs/

# 临时探测脚本
tool/_probe*.py
tool/_run_probe*.bat
