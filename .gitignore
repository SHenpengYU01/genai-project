# 本地环境变量（API key 等，不入库；模板 .env.example 入库）
.env
.env.*
!.env.example

# 本地环境说明（不入库）
*.txt

# 日志
*.log

# Python
__pycache__/
*.pyc

# CODESYS 生成物（模板工程 template.project 单独保留入库）
*.opt
*.precompilecache
*.simulation.*

# CODESYS 服务临时目录（生成的工程副本、请求/响应文件）
codesys/work/
codesys/compile/work/
codesys/simulate/work/

# 实验运行日志（结果按需单独保存/汇总进报告）
experiments/runs/

# 测试用例渲染缓存（参考实现逐拍实测值，可重算）
dataset/.cache/

# 临时探测脚本
codesys/_probe*.py
codesys/_run_probe*.bat
