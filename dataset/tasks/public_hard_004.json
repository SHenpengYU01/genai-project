{
  "id": "public_hard_004",
  "source": "public",
  "difficulty": "hard",
  "title": "柔性加工控制",
  "pou": {
    "type": "function_block",
    "name": "FlexProcess"
  },
  "requirement": {
    "en": "A line has 5 stations (1 feed, 2..4 processing, 5 output). processSequence holds the station numbers each product visits; processLength 1..8 is the active length from processSequence[1], final entry is 5. At start (sensor1 + station1Start) query the first sequence entry and move the conveyor to that station; on station2Complete..4Complete query the next entry and move accordingly until delivered to station 5.",
    "zh": "生产线有 5 个工位(1 上料、2..4 加工、5 成品)。processSequence 存储每个产品要经过的工位号；processLength 1..8 为有效长度，从 processSequence[1] 起，最后一项为 5。开始时(sensor1 且 station1Start) 查询第一个序列项并把输送带移到对应工位；收到 station2Complete..4Complete 后查询下一项并继续移动，直到送达 5 号工位。"
  },
  "interface": {
    "duts": [],
    "inputs": [
      {
        "name": "processLength",
        "type": "USINT",
        "desc": "有效序列长度 1..8"
      },
      {
        "name": "sensor1",
        "type": "BOOL",
        "desc": "1# 传感器"
      },
      {
        "name": "sensor2",
        "type": "BOOL",
        "desc": "2# 传感器"
      },
      {
        "name": "sensor3",
        "type": "BOOL",
        "desc": "3# 传感器"
      },
      {
        "name": "sensor4",
        "type": "BOOL",
        "desc": "4# 传感器"
      },
      {
        "name": "sensor5",
        "type": "BOOL",
        "desc": "5# 传感器"
      },
      {
        "name": "station1Start",
        "type": "BOOL",
        "desc": "1# 启动按钮"
      },
      {
        "name": "station2Complete",
        "type": "BOOL",
        "desc": "2# 加工完成"
      },
      {
        "name": "station3Complete",
        "type": "BOOL",
        "desc": "3# 加工完成"
      },
      {
        "name": "station4Complete",
        "type": "BOOL",
        "desc": "4# 加工完成"
      },
      {
        "name": "processSequence",
        "type": "ARRAY[1..8] OF USINT",
        "desc": "加工序列"
      }
    ],
    "outputs": [
      {
        "name": "conveyorLeft",
        "type": "BOOL",
        "desc": "输送带左转"
      },
      {
        "name": "conveyorRight",
        "type": "BOOL",
        "desc": "输送带右转"
      }
    ],
    "inouts": []
  },
  "ltl_specs": [
    {
      "id": "P1",
      "description": "左右转互斥。",
      "formula": "G(!(conveyorLeft && conveyorRight))"
    },
    {
      "id": "P2",
      "description": "最终送达 5 号工位。",
      "formula": "G((sensor1 && station1Start) -> F(sensor5))"
    }
  ],
