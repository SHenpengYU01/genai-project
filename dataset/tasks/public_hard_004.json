  "reference": {
    "duts": [],
    "pous": [
      {
        "name": "FlexProcess",
        "kind": "function_block",
        "declaration": "FUNCTION_BLOCK FlexProcess\nVAR_INPUT\n    processLength : USINT;\n    sensor1 : BOOL;\n    sensor2 : BOOL;\n    sensor3 : BOOL;\n    sensor4 : BOOL;\n    sensor5 : BOOL;\n    station1Start : BOOL;\n    station2Complete : BOOL;\n    station3Complete : BOOL;\n    station4Complete : BOOL;\n    processSequence : ARRAY[1..8] OF USINT;\nEND_VAR\nVAR_OUTPUT\n    conveyorLeft : BOOL;\n    conveyorRight : BOOL;\nEND_VAR\nVAR\n    stage : INT := 0;\n    seqIdx : USINT;\n    current : USINT;\n    target : USINT;\nEND_VAR\n",
        "implementation": "conveyorLeft := FALSE;\nconveyorRight := FALSE;\nCASE stage OF\n0:\n    IF sensor1 AND station1Start THEN\n        seqIdx := 1;\n        current := 1;\n        stage := 1;\n    END_IF\n1:\n    target := processSequence[seqIdx];\n    IF target > current THEN\n        conveyorRight := TRUE;\n    ELSIF target < current THEN\n        conveyorLeft := TRUE;\n    END_IF\n    IF (target = 1 AND sensor1) OR (target = 2 AND sensor2)\n        OR (target = 3 AND sensor3) OR (target = 4 AND sensor4)\n        OR (target = 5 AND sensor5) THEN\n        current := target;\n        IF target = 5 THEN\n            stage := 3;\n        ELSE\n            stage := 2;\n        END_IF\n    END_IF\n2:\n    IF (current = 2 AND station2Complete)\n        OR (current = 3 AND station3Complete)\n        OR (current = 4 AND station4Complete) THEN\n        seqIdx := seqIdx + 1;\n        stage := 1;\n    END_IF\n3:\nEND_CASE\n"
      }
    ]
  }
}