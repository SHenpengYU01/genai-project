{
  "id": "public_medium_001",
  "source": "public",
  "difficulty": "medium",
  "title": "多泵轮换供水控制",
  "pou": {
    "type": "function_block",
    "name": "MultiPump"
  },
  "requirement": {
    "en": "A water-supply system has 5 pumps. mode selects manual (FALSE) or automatic (TRUE). In manual mode each pump's RunComd follows its selection. In automatic mode compare priorities and select the 3 highest-priority pumps (three in use, two on standby). start starts the selected pumps, stop stops all pumps.",
    "zh": "供水系统有 5 台泵。mode 选择手动(FALSE)或自动(TRUE)。手动模式下每台泵的 RunComd 跟随其 selection；自动模式下比较优先级，按'三用二备'自动选出 3 台优先级更高的泵供水。start 启动所选泵，stop 停止所有泵。"
  },
  "interface": {
    "duts": [
      {
        "name": "ST_Pump",
        "kind": "struct",
        "fields": [
          {
            "name": "priority",
            "type": "INT",
            "desc": "优先级，越大越高"
          },
          {
            "name": "selection",
            "type": "BOOL",
            "desc": "手动选中状态"
          },
          {
            "name": "RunComd",
            "type": "BOOL",
            "desc": "运行命令"
          }
        ]
      }
    ],
    "inputs": [
      {
        "name": "mode",
        "type": "BOOL",
        "desc": "FALSE 手动 TRUE 自动"
      },
      {
        "name": "start",
        "type": "BOOL",
        "desc": "启动所选泵"
      },
      {
        "name": "stop",
        "type": "BOOL",
        "desc": "停止所有泵"
      }
    ],
    "outputs": [],
    "inouts": [
      {
        "name": "pumpGroup",
        "type": "ARRAY[1..5] OF ST_Pump",
        "desc": "5 台泵记录，读 priority/selection，写 RunComd"
      }
    ]
  },
  "ltl_specs": [
    {
      "id": "P1",
      "description": "停止优先：stop 时所有泵停止。",
      "formula": "G(stop -> !pumpGroup[1].RunComd)"
    },
    {
      "id": "P2",
      "description": "手动：选中的泵在 start 时运行。",
      "formula": "G((!mode && !stop && start && pumpGroup[1].selection) -> pumpGroup[1].RunComd)"
    },
    {
      "id": "P3",
      "description": "手动：未选中的泵不运行。",
      "formula": "G((!mode && !stop && start && !pumpGroup[1].selection) -> !pumpGroup[1].RunComd)"
    }
  ],
