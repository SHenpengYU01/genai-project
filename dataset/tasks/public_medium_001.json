  "reference": {
    "auto_wire": false,
    "duts": [
      {
        "name": "ST_Pump",
        "kind": "struct",
        "declaration": "TYPE ST_Pump :\nSTRUCT\n    priority : INT;\n    selection : BOOL;\n    RunComd : BOOL;\nEND_STRUCT\nEND_TYPE\n"
      }
    ],
    "pous": [
      {
        "name": "MultiPump",
        "kind": "function_block",
        "declaration": "FUNCTION_BLOCK MultiPump\nVAR_INPUT\n    mode : BOOL;\n    start : BOOL;\n    stop : BOOL;\nEND_VAR\nVAR_IN_OUT\n    pumpGroup : ARRAY[1..5] OF ST_Pump;\nEND_VAR\nVAR\n    i : INT;\n    j : INT;\n    higher : INT;\nEND_VAR\n",
        "implementation": "FOR i := 1 TO 5 DO\n    IF stop THEN\n        pumpGroup[i].RunComd := FALSE;\n    ELSIF start THEN\n        IF mode THEN\n            higher := 0;\n            FOR j := 1 TO 5 DO\n                IF pumpGroup[j].priority > pumpGroup[i].priority THEN\n                    higher := higher + 1;\n                END_IF\n            END_FOR\n            IF higher < 3 THEN\n                pumpGroup[i].RunComd := TRUE;\n            ELSE\n                pumpGroup[i].RunComd := FALSE;\n            END_IF\n        ELSE\n            pumpGroup[i].RunComd := pumpGroup[i].selection;\n        END_IF\n    END_IF\nEND_FOR\n"
      },
      {
        "name": "PLC_PRG",
        "kind": "program",
        "declaration": "PROGRAM PLC_PRG\nVAR\n    fb : MultiPump;\n    pumps : ARRAY[1..5] OF ST_Pump;\nEND_VAR\n",
        "implementation": "fb(mode := FALSE, start := FALSE, stop := FALSE, pumpGroup := pumps);\n"
      }
    ]
  }
}