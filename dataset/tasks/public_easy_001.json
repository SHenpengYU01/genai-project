{
  "id": "public_easy_001",
  "source": "public",
  "difficulty": "easy",
  "title": "自动灌装线控制",
  "pou": {
    "type": "function_block",
    "name": "FillingLine"
  },
  "requirement": {
    "en": "An automated filling line cleans, fills, caps and packages bottles. When bottleSensor detects a bottle, start the cleaning pump and keep it running. On cleaningConfirmButton, stop the pump and start the filling valve. On fillingConfirmButton, start the capping machine. On cappingConfirmButton, start the packing machine. On packingConfirmButton, turn on the completion light. On finishedButton, reset the light and get ready for the next bottle.",
    "zh": "自动灌装线负责清洗、灌装、封盖和打包瓶子。当 bottleSensor 检测到瓶子时，启动清洗泵并持续运行；收到 cleaningConfirmButton 后停止清洗泵并打开灌装阀；收到 fillingConfirmButton 后启动封盖机；收到 cappingConfirmButton 后启动打包机；收到 packingConfirmButton 后点亮完成指示灯；收到 finishedButton 后熄灭指示灯，准备下一个瓶子的生产周期。"
  },
  "interface": {
    "duts": [],
    "inputs": [
      {
        "name": "bottleSensor",
        "type": "BOOL",
        "desc": "检测到瓶子"
      },
      {
        "name": "cleaningConfirmButton",
        "type": "BOOL",
        "desc": "清洗完成确认"
      },
      {
        "name": "fillingConfirmButton",
        "type": "BOOL",
        "desc": "灌装完成确认"
      },
      {
        "name": "cappingConfirmButton",
        "type": "BOOL",
        "desc": "封盖完成确认"
      },
      {
        "name": "packingConfirmButton",
        "type": "BOOL",
        "desc": "打包完成确认"
      },
      {
        "name": "finishedButton",
        "type": "BOOL",
        "desc": "取走完成确认"
      }
    ],
    "outputs": [
      {
        "name": "Pump_Motor",
        "type": "BOOL",
        "desc": "清洗泵电机"
      },
      {
        "name": "Filling_Valve",
        "type": "BOOL",
        "desc": "灌装阀"
      },
      {
        "name": "Capping_Machine",
        "type": "BOOL",
        "desc": "封盖机"
      },
      {
        "name": "Packing_Machine",
        "type": "BOOL",
        "desc": "打包机"
      },
      {
        "name": "Completion_Light",
        "type": "BOOL",
        "desc": "完成指示灯"
      }
    ],
    "inouts": []
  },
  "ltl_specs": [
    {
      "id": "P1",
      "description": "各工位输出互斥（同一时刻至多一个工位激活）。",
      "formula": "G(!(Pump_Motor && Filling_Valve) && !(Filling_Valve && Capping_Machine) && !(Capping_Machine && Packing_Machine) && !(Packing_Machine && Completion_Light))"
    },
    {
      "id": "P2",
      "description": "检测到瓶子后启动清洗泵。",
      "formula": "G(bottleSensor -> X(Pump_Motor))"
    },
    {
      "id": "P3",
      "description": "清洗确认后进入灌装。",
      "formula": "G((Pump_Motor && cleaningConfirmButton) -> X(Filling_Valve))"
    },
    {
      "id": "P4",
      "description": "打包确认后点亮完成指示灯。",
      "formula": "G((Packing_Machine && packingConfirmButton) -> X(Completion_Light))"
    },
    {
      "id": "P5",
      "description": "取走确认后熄灭指示灯并复位。",
      "formula": "G((Completion_Light && finishedButton) -> X(!Completion_Light))"
    }
  ],
  "test_cases": [
    {
      "id": "TC1",
      "description": "完整生产流程顺序推进",
      "scan_ms": 10,
      "steps": [
        {
          "inputs": {
            "bottleSensor": false,
            "cleaningConfirmButton": false,
            "fillingConfirmButton": false,
            "cappingConfirmButton": false,
            "packingConfirmButton": false,
            "finishedButton": false
          },
          "expect": {},
          "purpose": "初始化：无瓶信号，各工位输出关闭"
        },
        {
          "inputs": {
            "bottleSensor": true,
            "cleaningConfirmButton": false,
            "fillingConfirmButton": false,
            "cappingConfirmButton": false,
            "packingConfirmButton": false,
            "finishedButton": false
          },
          "expect": {},
          "purpose": "检测到瓶子的当拍尚未启动清洗泵（下一拍生效）"
        },
        {
          "inputs": {
            "bottleSensor": false,
            "cleaningConfirmButton": false,
            "fillingConfirmButton": false,
            "cappingConfirmButton": false,
            "packingConfirmButton": false,
            "finishedButton": false
          },
          "expect": {
            "Pump_Motor": true
          },
          "purpose": "下一拍启动清洗泵，其余工位保持关闭"
        },
        {
          "inputs": {
            "bottleSensor": false,
            "cleaningConfirmButton": true,
            "fillingConfirmButton": false,
            "cappingConfirmButton": false,
            "packingConfirmButton": false,
            "finishedButton": false
          },
          "expect": {
            "Pump_Motor": true
          },
          "purpose": "清洗确认有效当拍维持清洗泵，工位尚未切换"
        },
        {
          "inputs": {
            "bottleSensor": false,
            "cleaningConfirmButton": false,
            "fillingConfirmButton": false,
            "cappingConfirmButton": false,
            "packingConfirmButton": false,
            "finishedButton": false
          },
          "expect": {
            "Filling_Valve": true
          },
          "purpose": "确认撤销后进入灌装：清洗泵停、灌装阀开"
        },
        {
          "inputs": {
            "bottleSensor": false,
            "cleaningConfirmButton": false,
            "fillingConfirmButton": true,
            "cappingConfirmButton": false,
            "packingConfirmButton": false,
            "finishedButton": false
          },
          "expect": {
            "Filling_Valve": true
          },
          "purpose": "灌装确认有效当拍保持灌装阀"
        },
        {
          "inputs": {
            "bottleSensor": false,
            "cleaningConfirmButton": false,
            "fillingConfirmButton": false,
            "cappingConfirmButton": false,
            "packingConfirmButton": false,
            "finishedButton": false
          },
          "expect": {
            "Capping_Machine": true
          },
          "purpose": "确认撤销后进入封盖：灌装阀关、封盖机开"
        },
        {
          "inputs": {
            "bottleSensor": false,
            "cleaningConfirmButton": false,
            "fillingConfirmButton": false,
            "cappingConfirmButton": true,
            "packingConfirmButton": false,
            "finishedButton": false
          },
          "expect": {
            "Capping_Machine": true
          },
          "purpose": "封盖确认有效当拍保持封盖机"
        },
        {
          "inputs": {
            "bottleSensor": false,
            "cleaningConfirmButton": false,
            "fillingConfirmButton": false,
            "cappingConfirmButton": false,
            "packingConfirmButton": false,
            "finishedButton": false
          },
          "expect": {
            "Packing_Machine": true
          },
          "purpose": "确认撤销后进入打包：封盖机停、打包机开"
        },
        {
          "inputs": {
            "bottleSensor": false,
            "cleaningConfirmButton": false,
            "fillingConfirmButton": false,
            "cappingConfirmButton": false,
            "packingConfirmButton": true,
            "finishedButton": false
          },
          "expect": {
            "Packing_Machine": true
          },
          "purpose": "打包确认有效当拍保持打包机"
        },
        {
          "inputs": {
            "bottleSensor": false,
            "cleaningConfirmButton": false,
            "fillingConfirmButton": false,
            "cappingConfirmButton": false,
            "packingConfirmButton": false,
            "finishedButton": false
          },
          "expect": {
            "Completion_Light": true
          },
          "purpose": "确认撤销后点亮完成指示灯"
        },
        {
          "inputs": {
            "bottleSensor": false,
            "cleaningConfirmButton": false,
            "fillingConfirmButton": false,
            "cappingConfirmButton": false,
            "packingConfirmButton": false,
            "finishedButton": true
          },
          "expect": {
            "Completion_Light": true
          },
          "purpose": "取走确认有效当拍保持完成指示灯"
        },
        {
          "inputs": {
            "bottleSensor": false,
            "cleaningConfirmButton": false,
            "fillingConfirmButton": false,
            "cappingConfirmButton": false,
            "packingConfirmButton": false,
            "finishedButton": false
          },
          "expect": {},
          "purpose": "取走确认撤销后指示灯熄灭，流程回到起点"
        }
      ],
      "initialState": "新建功能块实例，内部状态与输出全部清零；输入取下表周期 0 的取值。尚无可检测的瓶子，所有工位关闭。",
      "coverage": [
        "检测到瓶子后启动清洗泵（正常流程入口）",
        "按确认按钮顺序推进：清洗→灌装→封盖→打包→完成指示灯",
        "工位切换时的互斥：进入下一工位时上一工位输出撤销",
        "确认信号有效当拍维持当前工位，撤销后才切换",
        "取走确认后熄灭指示灯，回到可接收下一个瓶子的状态"
      ],
      "specRefs": [
        "P1",
        "P2",
        "P3",
        "P4",
        "P5"
      ]
    }
  ],
  "reference": {
    "duts": [],
    "pous": [
      {
        "name": "FillingLine",
        "kind": "function_block",
        "declaration": "FUNCTION_BLOCK FillingLine\nVAR_INPUT\n    bottleSensor : BOOL;\n    cleaningConfirmButton : BOOL;\n    fillingConfirmButton : BOOL;\n    cappingConfirmButton : BOOL;\n    packingConfirmButton : BOOL;\n    finishedButton : BOOL;\nEND_VAR\nVAR_OUTPUT\n    Pump_Motor : BOOL;\n    Filling_Valve : BOOL;\n    Capping_Machine : BOOL;\n    Packing_Machine : BOOL;\n    Completion_Light : BOOL;\nEND_VAR\nVAR\n    stage : INT := 0;\nEND_VAR\n",
        "implementation": "Pump_Motor := FALSE;\nFilling_Valve := FALSE;\nCapping_Machine := FALSE;\nPacking_Machine := FALSE;\nCompletion_Light := FALSE;\nCASE stage OF\n0:\n    IF bottleSensor THEN\n        stage := 1;\n    END_IF\n1:\n    Pump_Motor := TRUE;\n    IF cleaningConfirmButton THEN\n        stage := 2;\n    END_IF\n2:\n    Filling_Valve := TRUE;\n    IF fillingConfirmButton THEN\n        stage := 3;\n    END_IF\n3:\n    Capping_Machine := TRUE;\n    IF cappingConfirmButton THEN\n        stage := 4;\n    END_IF\n4:\n    Packing_Machine := TRUE;\n    IF packingConfirmButton THEN\n        stage := 5;\n    END_IF\n5:\n    Completion_Light := TRUE;\n    IF finishedButton THEN\n        stage := 0;\n    END_IF\nEND_CASE\n"
      }
    ]
  }
}