{
  "id": "public_medium_003",
  "source": "public",
  "difficulty": "medium",
  "title": "温度控制逻辑",
  "pou": {
    "type": "function_block",
    "name": "TempControl"
  },
  "requirement": {
    "en": "Compare TemperatureSensorInput with SetTemperature: heat when below, stop when above. If the heater runs continuously over 5s, trigger overheat protection, turn off the heater and wait 3s before lifting. Temperature sensor below 0 or above 100 is a fault and turns the heater off.",
    "zh": "比较 TemperatureSensorInput 与 SetTemperature：低于设定值加热，高于设定值停止。若加热器连续工作超过 5s 则触发过热保护、自动关断，并须等待 3s 后才能解除保护。温度传感器读数小于 0 或大于 100 视为传感器故障，关断加热器。"
  },
  "interface": {
    "duts": [],
    "inputs": [
      {
        "name": "TemperatureSensorInput",
        "type": "REAL",
        "desc": "实际温度"
      },
      {
        "name": "SetTemperature",
        "type": "REAL",
        "desc": "设定温度"
      }
    ],
    "outputs": [
      {
        "name": "CurrentTemperature",
        "type": "REAL",
        "desc": "当前温度显示"
      },
      {
        "name": "SetTempDisplay",
        "type": "REAL",
        "desc": "设定温度显示"
      },
      {
        "name": "HeaterStatus",
        "type": "BOOL",
        "desc": "加热器状态显示"
      },
      {
        "name": "OverheatProtection",
        "type": "BOOL",
        "desc": "过热保护状态"
      },
      {
        "name": "HeaterOutput",
        "type": "BOOL",
        "desc": "加热器控制输出"
      }
    ],
    "inouts": []
  },
  "ltl_specs": [
    {
      "id": "P1",
      "description": "传感器故障时关断加热器。",
      "formula": "G((TemperatureSensorInput < 0 || TemperatureSensorInput > 100) -> !HeaterOutput)"
    },
    {
      "id": "P2",
      "description": "低温且无故障/保护时加热。",
      "formula": "G((TemperatureSensorInput < SetTemperature && !OverheatProtection) -> HeaterOutput)"
    },
    {
      "id": "P3",
      "description": "过热保护时禁止加热。",
      "formula": "G(OverheatProtection -> !HeaterOutput)"
    }
  ],
  "test_cases": [
    {
      "id": "TC1",
      "description": "低温加热高温停止",
      "scan_ms": 1000,
      "steps": [
        {
          "inputs": {
            "TemperatureSensorInput": 30.0,
            "SetTemperature": 50.0
          },
          "expect": {
            "HeaterOutput": true,
            "OverheatProtection": false
          }
        },
        {
          "inputs": {
            "TemperatureSensorInput": 60.0,
            "SetTemperature": 50.0
          },
          "expect": {
            "HeaterOutput": false,
            "OverheatProtection": false
          }
        }
      ]
    },
    {
      "id": "TC2",
      "description": "传感器故障关断",
      "scan_ms": 1000,
      "steps": [
        {
          "inputs": {
            "TemperatureSensorInput": 150.0,
            "SetTemperature": 50.0
          },
          "expect": {
            "HeaterOutput": false
          }
        }
      ]
    },
    {
      "id": "TC3",
      "description": "过热保护与恢复",
      "scan_ms": 1000,
      "steps": [
        {
          "inputs": {
            "TemperatureSensorInput": 30.0,
            "SetTemperature": 50.0
          },
          "expect": {
            "HeaterOutput": true,
            "OverheatProtection": false
          }
        },
        {
          "inputs": {
            "TemperatureSensorInput": 30.0,
            "SetTemperature": 50.0
          },
          "expect": {
            "HeaterOutput": true,
            "OverheatProtection": false
          }
        },
        {
          "inputs": {
            "TemperatureSensorInput": 30.0,
            "SetTemperature": 50.0
          },
          "expect": {
            "HeaterOutput": true,
            "OverheatProtection": false
          }
        },
        {
          "inputs": {
            "TemperatureSensorInput": 30.0,
            "SetTemperature": 50.0
          },
          "expect": {
            "HeaterOutput": true,
            "OverheatProtection": false
          }
        },
        {
          "inputs": {
            "TemperatureSensorInput": 30.0,
            "SetTemperature": 50.0
          },
          "expect": {
            "HeaterOutput": false,
            "OverheatProtection": true
          }
        },
        {
          "inputs": {
            "TemperatureSensorInput": 30.0,
            "SetTemperature": 50.0
          },
          "expect": {
            "HeaterOutput": false,
            "OverheatProtection": true
          }
        },
        {
          "inputs": {
            "TemperatureSensorInput": 30.0,
            "SetTemperature": 50.0
          },
          "expect": {
            "HeaterOutput": false,
            "OverheatProtection": true
          }
        },
        {
          "inputs": {
            "TemperatureSensorInput": 30.0,
            "SetTemperature": 50.0
          },
          "expect": {
            "HeaterOutput": false,
            "OverheatProtection": false
          }
        },
        {
          "inputs": {
            "TemperatureSensorInput": 30.0,
            "SetTemperature": 50.0
          },
          "expect": {
            "HeaterOutput": true,
            "OverheatProtection": false
          }
        }
      ]
    }
  ],
  "reference": {
    "duts": [],
    "pous": [
      {
        "name": "TempControl",
        "kind": "function_block",
        "declaration": "FUNCTION_BLOCK TempControl\nVAR_INPUT\n    TemperatureSensorInput : REAL;\n    SetTemperature : REAL;\nEND_VAR\nVAR_OUTPUT\n    CurrentTemperature : REAL;\n    SetTempDisplay : REAL;\n    HeaterStatus : BOOL;\n    OverheatProtection : BOOL;\n    HeaterOutput : BOOL;\nEND_VAR\nVAR\n    phase : INT := 0;\n    heatCmd : BOOL;\n    heatTimer : TON;\n    coolTimer : TON;\nEND_VAR\n",
        "implementation": "CurrentTemperature := TemperatureSensorInput;\nSetTempDisplay := SetTemperature;\nCASE phase OF\n0:\n    IF TemperatureSensorInput < 0.0 OR TemperatureSensorInput > 100.0 THEN\n        heatCmd := FALSE;\n    ELSIF TemperatureSensorInput < SetTemperature THEN\n        heatCmd := TRUE;\n    ELSIF TemperatureSensorInput > SetTemperature THEN\n        heatCmd := FALSE;\n    END_IF\n    heatTimer(IN := heatCmd, PT := T#5s);\n    IF heatTimer.Q THEN\n        phase := 1;\n        HeaterOutput := FALSE;\n    ELSE\n        HeaterOutput := heatCmd;\n    END_IF\n1:\n    HeaterOutput := FALSE;\n    coolTimer(IN := TRUE, PT := T#3s);\n    IF coolTimer.Q THEN\n        phase := 0;\n        heatTimer(IN := FALSE, PT := T#5s);\n        coolTimer(IN := FALSE, PT := T#3s);\n    END_IF\nEND_CASE\nOverheatProtection := (phase = 1);\nHeaterStatus := HeaterOutput;\n"
      }
    ]
  }
}