{
  "id": "public_medium_005",
  "source": "public",
  "difficulty": "medium",
  "title": "自动化生产线控制",
  "pou": {
    "type": "function_block",
    "name": "ProductionLine"
  },
  "requirement": {
    "en": "A line moves a product through stations A, B, C. Mode switches manual/automatic. Manual: ForwardButton drives forward, ReverseButton reverse, interlocked. Automatic: SensorA+ButtonA moves forward to B; SensorB stops, ButtonB moves to C; SensorC stops, ButtonC turns on CompletionLight; when SensorC clears the light turns off.",
    "zh": "生产线把产品依次送过工位 A、B、C。Mode 切换手动/自动。手动：ForwardButton 正转、ReverseButton 反转，且互锁不可同时。自动：SensorA 检测到产品且 ButtonA 确认后正转送向 B；SensorB 检测到后停止，ButtonB 确认后正转送向 C；SensorC 检测到后停止，ButtonC 确认后点亮 CompletionLight；产品被取走(SensorC 消失)后熄灭。"
  },
  "interface": {
    "duts": [],
    "inputs": [
      {
        "name": "Mode",
        "type": "BOOL",
        "desc": "0 手动 1 自动"
      },
      {
        "name": "ForwardButton",
        "type": "BOOL",
        "desc": "正转按钮"
      },
      {
        "name": "ReverseButton",
        "type": "BOOL",
        "desc": "反转按钮"
      },
      {
        "name": "SensorA",
        "type": "BOOL",
        "desc": "A 工位传感器"
      },
      {
        "name": "SensorB",
        "type": "BOOL",
        "desc": "B 工位传感器"
      },
      {
        "name": "SensorC",
        "type": "BOOL",
        "desc": "C 工位传感器"
      },
      {
        "name": "ButtonA",
        "type": "BOOL",
        "desc": "A 工位完成按钮"
      },
      {
        "name": "ButtonB",
        "type": "BOOL",
        "desc": "B 工位完成按钮"
      },
      {
        "name": "ButtonC",
        "type": "BOOL",
        "desc": "C 工位完成按钮"
      }
    ],
    "outputs": [
      {
        "name": "MotorForward",
        "type": "BOOL",
        "desc": "正转输出"
      },
      {
        "name": "MotorReverse",
        "type": "BOOL",
        "desc": "反转输出"
      },
      {
        "name": "CompletionLight",
        "type": "BOOL",
        "desc": "完成指示灯"
      }
    ],
    "inouts": []
  },
  "ltl_specs": [
    {
      "id": "P1",
      "description": "正反转互锁。",
      "formula": "G(!(MotorForward && MotorReverse))"
    },
    {
      "id": "P2",
      "description": "手动正转。",
      "formula": "G((!Mode && ForwardButton && !ReverseButton) -> MotorForward)"
    },
    {
      "id": "P3",
      "description": "完成灯只在产品位于 C 工位时点亮。",
      "formula": "G(CompletionLight -> SensorC)"
    }
  ],
  "test_cases": [
