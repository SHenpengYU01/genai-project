  "reference": {
    "duts": [],
    "pous": [
      {
        "name": "ProductionLine",
        "kind": "function_block",
        "declaration": "FUNCTION_BLOCK ProductionLine\nVAR_INPUT\n    Mode : BOOL;\n    ForwardButton : BOOL;\n    ReverseButton : BOOL;\n    SensorA : BOOL;\n    SensorB : BOOL;\n    SensorC : BOOL;\n    ButtonA : BOOL;\n    ButtonB : BOOL;\n    ButtonC : BOOL;\nEND_VAR\nVAR_OUTPUT\n    MotorForward : BOOL;\n    MotorReverse : BOOL;\n    CompletionLight : BOOL;\nEND_VAR\nVAR\n    stage : INT := 0;\nEND_VAR\n",
        "implementation": "MotorForward := FALSE;\nMotorReverse := FALSE;\nCompletionLight := FALSE;\nIF NOT Mode THEN\n    IF ReverseButton AND NOT ForwardButton THEN\n        MotorReverse := TRUE;\n    ELSIF ForwardButton AND NOT ReverseButton THEN\n        MotorForward := TRUE;\n    END_IF\n    stage := 0;\nELSE\n    CASE stage OF\n    0:\n        IF SensorA AND ButtonA THEN\n            stage := 1;\n        END_IF\n    1:\n        MotorForward := TRUE;\n        IF SensorB THEN\n            stage := 2;\n        END_IF\n    2:\n        IF ButtonB THEN\n            stage := 3;\n        END_IF\n    3:\n        MotorForward := TRUE;\n        IF SensorC THEN\n            stage := 4;\n        END_IF\n    4:\n        IF ButtonC THEN\n            stage := 5;\n        END_IF\n    5:\n        CompletionLight := TRUE;\n        IF NOT SensorC THEN\n            stage := 0;\n        END_IF\n    END_CASE\nEND_IF\n"
      }
    ]
  }
}