            "ButtonA": false,
            "ButtonB": false,
            "ButtonC": false
          },
          "expect": {
            "MotorForward": true,
            "MotorReverse": false
          },
          "purpose": "手动模式按下正转：MotorForward 有效，反转无效"
        },
        {
          "inputs": {
            "Mode": false,
            "ForwardButton": false,
            "ReverseButton": true,
            "SensorA": false,
            "SensorB": false,
            "SensorC": false,
            "ButtonA": false,
            "ButtonB": false,
            "ButtonC": false
          },
          "expect": {
            "MotorForward": false,
            "MotorReverse": true
          },
          "purpose": "同时按下反转：正转撤销、反转有效"
