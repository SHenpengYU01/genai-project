{
  "id": "self_easy_003",
  "source": "self_built",
  "difficulty": "easy",
  "title": "自动门控制",
  "pou": {
    "type": "function_block",
    "name": "AutoDoor"
  },
  "requirement": {
    "zh": "控制自动门：感应到人时开门，完全开启后保持 3 秒再关门；关门过程中若再次感应到人或检测到障碍物则重新开门。",
    "en": "Control an automatic door: open on presence, hold 3s after fully open, then close; if presence or an obstacle is detected while closing, reopen."
  },
  "interface": {
    "duts": [],
    "inouts": [],
    "inputs": [
      {
        "name": "presence",
        "type": "BOOL",
        "desc": "有人感应"
      },
      {
        "name": "openLimit",
        "type": "BOOL",
        "desc": "开到位"
      },
      {
        "name": "closeLimit",
        "type": "BOOL",
        "desc": "关到位"
      },
      {
        "name": "obstacle",
        "type": "BOOL",
        "desc": "障碍物"
      }
    ],
    "outputs": [
      {
        "name": "openCmd",
        "type": "BOOL",
        "desc": "开门命令"
      },
      {
        "name": "closeCmd",
        "type": "BOOL",
        "desc": "关门命令"
      }
    ]
  },
  "meta": {
    "scenario": "门控/离散逻辑，含延时与障碍物重开，考查状态机与定时器。"
  },
  "ltl_specs": [
    {
      "id": "P1",
      "description": "开门与关门互斥。",
      "formula": "G(!(openCmd && closeCmd))"
    },
    {
      "id": "P2",
      "description": "有人时开门。",
      "formula": "G(presence -> openCmd)"
    }
  ],
  "test_cases": [
    {
      "id": "TC1",
      "description": "开门保持后关门",
      "scan_ms": 1000,
      "steps": [
        {
          "inputs": {
            "presence": true,
            "openLimit": false,
            "closeLimit": false,
            "obstacle": false
          },
          "expect": {
            "openCmd": false,
            "closeCmd": false
          },
          "purpose": "有人：状态机进入开门状态，本拍开门命令尚未输出（下一拍生效）"
        },
        {
          "inputs": {
            "presence": false,
            "openLimit": true,
            "closeLimit": false,
            "obstacle": false
          },
          "expect": {
            "openCmd": true,
            "closeCmd": false
          },
          "purpose": "开门命令输出，同时开到位信号触发状态迁移"
        },
        {
          "inputs": {
            "presence": false,
            "openLimit": true,
            "closeLimit": false,
            "obstacle": false
          },
          "repeat": 3,
          "expect": {
            "openCmd": false,
            "closeCmd": false
          },
          "purpose": "完全开启后保持 3s（hold 定时器 3 拍）"
        },
        {
          "inputs": {
            "presence": false,
            "openLimit": true,
            "closeLimit": false,
            "obstacle": false
          },
          "repeat": 1,
          "expect": {
            "openCmd": false,
            "closeCmd": false
          },
          "purpose": "保持时间到：状态迁到关门，本拍关门命令尚未输出"
        },
        {
          "inputs": {
            "presence": false,
            "openLimit": true,
            "closeLimit": false,
            "obstacle": false
          },
          "repeat": 1,
          "expect": {
            "openCmd": false,
            "closeCmd": true
          },
          "purpose": "关门命令输出"
        }
      ],
      "initialState": "新建功能块实例，内部状态与输出全部清零；输入取下表周期 0 的取值。门处于关门静止状态（stage 0），保持定时器未启动。",
      "coverage": [
        "感应到人后进入开门状态（P2）",
        "开到位（openLimit）后进入保持状态",
        "完全开启后保持 3s 再关门",
        "开门与关门命令互斥（P1）"
      ],
      "specRefs": [
        "P1",
        "P2"
      ]
    },
    {
      "id": "TC2",
      "description": "关门遇障碍重开",
      "scan_ms": 1000,
      "steps": [
        {
          "inputs": {
            "presence": true,
            "openLimit": false,
            "closeLimit": false,
            "obstacle": false
          },
          "expect": {
            "openCmd": false,
            "closeCmd": false
          },
          "purpose": "有人：进入开门状态，本拍无命令"
        },
        {
          "inputs": {
            "presence": false,
            "openLimit": true,
            "closeLimit": false,
            "obstacle": false
          },
          "expect": {
            "openCmd": true,
            "closeCmd": false
          },
          "purpose": "开门命令输出并开到位"
        },
        {
          "inputs": {
            "presence": false,
            "openLimit": true,
            "closeLimit": false,
            "obstacle": false
          },
          "repeat": 3,
          "expect": {
            "openCmd": false,
            "closeCmd": false
          },
          "purpose": "完全开启后保持 3s"
        },
        {
          "inputs": {
            "presence": false,
            "openLimit": true,
            "closeLimit": false,
            "obstacle": false
          },
          "repeat": 1,
          "expect": {
            "openCmd": false,
            "closeCmd": false
          },
          "purpose": "保持时间到：状态迁到关门"
        },
        {
          "inputs": {
            "presence": false,
            "openLimit": true,
            "closeLimit": false,
            "obstacle": false
          },
          "repeat": 1,
          "expect": {
            "openCmd": false,
            "closeCmd": true
          },
          "purpose": "关门命令输出"
        },
        {
          "inputs": {
            "presence": false,
            "openLimit": true,
            "closeLimit": false,
            "obstacle": true
          },
          "expect": {
            "openCmd": false,
            "closeCmd": true
          },
          "purpose": "障碍物出现当拍：命令尚未改变（状态迁移下一拍生效）"
        },
        {
          "inputs": {
            "presence": false,
            "openLimit": true,
            "closeLimit": false,
            "obstacle": false
          },
          "expect": {
            "openCmd": true,
            "closeCmd": false
          },
          "purpose": "障碍物后一个扫描：重新开门，关门命令撤销"
        }
      ],
      "initialState": "新建功能块实例，内部状态与输出全部清零；输入取下表周期 0 的取值。门处于关门静止状态（stage 0），保持定时器未启动。",
      "coverage": [
        "前段与 TC1 相同：开门→保持→关门",
        "关门过程中检测到障碍物时重新开门",
        "重新开门后关门命令撤销（P1 互斥）"
      ],
      "specRefs": [
        "P1",
        "P2"
      ]
    }
  ],
  "reference": {
    "duts": [],
    "pous": [
      {
        "name": "AutoDoor",
        "kind": "function_block",
        "declaration": "FUNCTION_BLOCK AutoDoor\nVAR_INPUT\n    presence : BOOL;\n    openLimit : BOOL;\n    closeLimit : BOOL;\n    obstacle : BOOL;\nEND_VAR\nVAR_OUTPUT\n    openCmd : BOOL;\n    closeCmd : BOOL;\nEND_VAR\nVAR\n    stage : INT := 0;\n    hold : TON;\nEND_VAR\n",
        "implementation": "openCmd := FALSE;\ncloseCmd := FALSE;\nCASE stage OF\n0:\n    IF presence THEN\n        stage := 1;\n    END_IF\n1:\n    openCmd := TRUE;\n    IF openLimit THEN\n        stage := 2;\n    END_IF\n2:\n    IF presence OR obstacle THEN\n        stage := 1;\n    ELSE\n        hold(IN := TRUE, PT := T#3s);\n        IF hold.Q THEN\n            stage := 3;\n        END_IF\n    END_IF\n3:\n    closeCmd := TRUE;\n    IF presence OR obstacle THEN\n        stage := 1;\n        hold(IN := FALSE, PT := T#3s);\n    ELSIF closeLimit THEN\n        stage := 0;\n    END_IF\nEND_CASE\n"
      }
    ]
  }
}