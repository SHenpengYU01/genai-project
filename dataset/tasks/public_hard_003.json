  "reference": {
    "duts": [],
    "pous": [
      {
        "name": "ProductionControl",
        "kind": "function_block",
        "declaration": "FUNCTION_BLOCK ProductionControl\nVAR_INPUT\n    Mode : BOOL;\n    ForwardButton : BOOL;\n    ReverseButton : BOOL;\n    SensorFeed : BOOL;\n    SensorWash : BOOL;\n    SensorWeight : BOOL;\n    SensorFiring : BOOL;\n    SensorOutput : BOOL;\n    washComplete : BOOL;\n    weightComplete : BOOL;\n    weight : REAL;\n    firingComplete : BOOL;\nEND_VAR\nVAR_OUTPUT\n    MotorForward : BOOL;\n    MotorReverse : BOOL;\n    kick : BOOL;\n    CompletionLight : BOOL;\n    firingTemp : REAL;\nEND_VAR\nVAR\n    stage : INT := 0;\nEND_VAR\n",
        "implementation": "MotorForward := FALSE;\nMotorReverse := FALSE;\nkick := FALSE;\nCompletionLight := FALSE;\nIF NOT Mode THEN\n    IF ReverseButton AND NOT ForwardButton THEN\n        MotorReverse := TRUE;\n    ELSIF ForwardButton AND NOT ReverseButton THEN\n        MotorForward := TRUE;\n    END_IF\n    stage := 0;\nELSE\n    CASE stage OF\n    0:\n        IF SensorFeed THEN\n            stage := 1;\n        END_IF\n    1:\n        MotorForward := TRUE;\n        IF SensorWash THEN\n            stage := 2;\n        END_IF\n    2:\n        IF washComplete THEN\n            stage := 3;\n        END_IF\n    3:\n        MotorForward := TRUE;\n        IF SensorWeight THEN\n            stage := 4;\n        END_IF\n    4:\n        IF weightComplete THEN\n            IF weight >= 100.0 AND weight <= 200.0 THEN\n                firingTemp := 500.0 + (weight - 100.0) * 0.5;\n                stage := 5;\n            ELSE\n                kick := TRUE;\n                stage := 0;\n            END_IF\n        END_IF\n    5:\n        MotorForward := TRUE;\n        IF SensorFiring THEN\n            stage := 6;\n        END_IF\n    6:\n        IF firingComplete THEN\n            stage := 7;\n        END_IF\n    7:\n        MotorForward := TRUE;\n        IF SensorOutput THEN\n            stage := 8;\n        END_IF\n    8:\n        CompletionLight := TRUE;\n        IF NOT SensorOutput THEN\n            stage := 0;\n        END_IF\n    END_CASE\nEND_IF\n"
      }
    ]
  }
