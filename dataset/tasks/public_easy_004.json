  "reference": {
    "duts": [],
    "pous": [
      {
        "name": "JamPump",
        "kind": "function_block",
        "declaration": "FUNCTION_BLOCK JamPump\nVAR_INPUT\n    VISCOSITY_OK : BOOL;\n    PASTE_E_STOP_NC : BOOL;\n    DebounceTime : TIME;\n    CycleTime : TIME;\nEND_VAR\nVAR_OUTPUT\n    VFD_RUN : BOOL;\n    PUMP_MAINT_DUE : BOOL;\n    PUMP_RUNTIME_ACC : LTIME;\nEND_VAR\nVAR\n    debounceElapsed : LTIME := LTIME#0ms;\n    viscValid : BOOL;\nEND_VAR\n",
        "implementation": "IF NOT VISCOSITY_OK THEN\n    viscValid := FALSE;\n    debounceElapsed := LTIME#0ms;\nELSIF NOT PASTE_E_STOP_NC THEN\n    viscValid := FALSE;\n    debounceElapsed := LTIME#0ms;\nELSIF NOT viscValid THEN\n    debounceElapsed := debounceElapsed + TO_LTIME(CycleTime);\n    IF debounceElapsed >= TO_LTIME(DebounceTime) THEN\n        viscValid := TRUE;\n    END_IF\nEND_IF\nIF PASTE_E_STOP_NC AND viscValid THEN\n    VFD_RUN := TRUE;\nELSE\n    VFD_RUN := FALSE;\nEND_IF\nIF VFD_RUN THEN\n    PUMP_RUNTIME_ACC := PUMP_RUNTIME_ACC + TO_LTIME(CycleTime);\nEND_IF\nIF PUMP_RUNTIME_ACC >= TO_LTIME(T#500h) THEN\n    PUMP_MAINT_DUE := TRUE;\nEND_IF\n"
      }
    ]
  }
