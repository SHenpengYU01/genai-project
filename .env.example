# 复制为 .env 并填入真实密钥（.env 已被 .gitignore 忽略，不会入库）
# Copy to .env and fill in real keys (.env is gitignored).

# DeepSeek（https://platform.deepseek.com/api_keys）
DEEPSEEK_API_KEY=

# 阿里云百炼 DashScope / Qwen（https://bailian.console.aliyun.com/?apiKey=1）
DASHSCOPE_API_KEY=

# 可选：覆盖默认端点/模型（一般不需要）
# AGENT_BASE_URL=https://api.deepseek.com/v1
# AGENT_MODEL=deepseek-chat
