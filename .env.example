# 复制为 .env 并填入真实密钥（.env 已被 .gitignore 忽略，不会入库）
# Copy to .env and fill in real keys (.env is gitignored).

# DMXAPI：一个 Key 调用 DeepSeek / Qwen 等（https://www.dmxapi.cn）
# 找助教获取本组 API key
DMXAPI_API_KEY=

# 模型名：到 https://www.dmxapi.cn/rmb 复制准确名称后填写（区分大小写）
# 留空则使用默认值：deepseek=DeepSeek-V3.2, qwen=qwen3-max
DMXAPI_MODEL_DEEPSEEK=
DMXAPI_MODEL_QWEN=

# 可选：整体覆盖端点/密钥（一般不需要）
# AGENT_BASE_URL=https://www.dmxapi.cn/v1
# AGENT_API_KEY=
